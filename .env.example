# Postgres connection string (pooled, used at runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tempkey"
# Direct (unpooled) connection string, used only for prisma migrate deploy.
# Local dev: same as DATABASE_URL. Hosted Postgres (Neon/Vercel Postgres): the
# non-pooling/direct variant they provide alongside the pooled one.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tempkey"

# Any random string, used to sign session tokens
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Slack app (https://api.slack.com/apps) - scopes: channels:manage, groups:write, channels:read, groups:read, users:read
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Google OAuth client (https://console.cloud.google.com) - Drive API enabled, scope: drive (or drive.file to start)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Trello API key (https://trello.com/power-ups/admin) - user tokens are issued per-connection, no secret at app level
TRELLO_API_KEY=""
# Same value as TRELLO_API_KEY, mirrored for client-side use: the Trello authorize
# redirect (#token=... in the URL fragment) happens entirely in the browser, so the
# connect page needs the key without a server round trip. Trello API keys are meant
# to be public (paired with a per-user token), so this is safe to expose.
NEXT_PUBLIC_TRELLO_API_KEY=""

# Notion integration (https://www.notion.so/my-integrations) - read-only use: showing which pages a contractor can see
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Shared secret the external cron caller must send to hit /api/cron/revoke
CRON_SECRET="change-me-too"
